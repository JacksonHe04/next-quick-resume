{
  "name": "sayless",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "start": "next start",
    "dev:worker": "wrangler dev --port 8787",
    "deploy:worker": "wrangler deploy",
    "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sayless-production --local",
    "db:seed:local": "pnpm db:migrate:local && tsx db/seed/local.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:prepare": "pnpm db:seed:local && tsx e2e/prepare.ts",
    "e2e": "pnpm e2e:prepare && playwright test",
    "e2e:production": "playwright test e2e/production-smoke.spec.ts --project=chromium",
    "check": "pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "5.101.2",
    "@types/pdf-parse": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.22.0",
    "next": "16.2.11",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.80.0",
    "recharts": "^3.6.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.18.0",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "4.7.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.4.0",
    "jsdom": "26.1.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "3.2.7",
    "wrangler": "4.114.0",
    "yaml": "2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.0.10",
      "brace-expansion@>=5.0.0 <5.0.8": "5.0.8",
      "esbuild@<0.25.0": "0.25.0",
      "flatted@<3.4.2": "3.4.2",
      "js-yaml": "4.3.0",
      "minimatch@<3.1.4": "3.1.4",
      "picomatch": "2.3.2",
      "postcss": "8.5.23",
      "sharp": "0.35.3",
      "ws@<8.21.0": "8.21.0"
    }
  }
}
