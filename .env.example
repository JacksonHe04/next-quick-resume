D1_GATEWAY_URL=https://sayless-api.yingyingdontkill.workers.dev
D1_GATEWAY_TOKEN=

INON_SSO_CLIENT_ID=
INON_SSO_CLIENT_SECRET=
INON_SSO_SESSION_SECRET=
INON_SSO_PUBLIC_ORIGIN=http://localhost:3000

# Local development identity override. When NODE_ENV=development, every request
# is authenticated as this user without the iNon SSO redirect. The email is
# matched (and linked on first login) against the local D1 users table.
# Defaults: yingyingdontkill@gmail.com / Jackson / dev-local-user
SAYLESS_DEV_USER_ID=
SAYLESS_DEV_USER_EMAIL=
SAYLESS_DEV_USER_NAME=
